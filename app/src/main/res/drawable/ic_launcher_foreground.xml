        android:fillType="nonZero"
        android:pathData="M74,30 L45,58 L57,58 L34,78 L44,52 L32,52 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="32"
                android:startY="30"
                android:endX="74"
                android:endY="78">
                <item android:color="#FFD600" android:offset="0.0"/>
                <item android:color="#FF6D00" android:offset="1.0"/>
